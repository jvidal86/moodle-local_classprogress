<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/classprogress/db" VERSION="20261018" COMMENT="XMLDB file for Moodle local/classprogress"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_classprogress_schoolyear" COMMENT="A teacher's school year: its dates hold the holidays and evaluation periods shared by all of that teacher's plan activities in the year.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Owner."/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="startdate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="First day, ISO yyyy-mm-dd."/>
        <FIELD NAME="enddate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last day, ISO yyyy-mm-dd."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_classprogress_holiday" COMMENT="A holiday (one day or a period) of a school year; owned through the school year.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="schoolyearid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="startdate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="First day, ISO yyyy-mm-dd."/>
        <FIELD NAME="enddate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last day, ISO yyyy-mm-dd; equal to startdate for a single day."/>
        <FIELD NAME="label" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Text after the dates; empty when there is none."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="schoolyearid" TYPE="foreign" FIELDS="schoolyearid" REFTABLE="local_classprogress_schoolyear" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_classprogress_evaluation" COMMENT="An evaluation period of a school year (1a, 2a, 3a avaluació), used to group the export summary.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="schoolyearid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="startdate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="First day, ISO yyyy-mm-dd."/>
        <FIELD NAME="enddate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Last day, ISO yyyy-mm-dd."/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="schoolyearid" TYPE="foreign" FIELDS="schoolyearid" REFTABLE="local_classprogress_schoolyear" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
