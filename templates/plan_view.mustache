{{!
    @template local_classprogress/plan_view

    The status of a plan and its days, grouped by RA or block in the order of the text.

    Context variables required for this template:
    * approved - Whether the plan is approved.
    * status - The status as a sentence.
    * hasitems - Whether the plan has days.
    * blocks - The RA or blocks, each with:
      * name - Name as typed (escaped here).
      * days - Its days, each with date, title (as typed, escaped here), hours (empty when unknown) and content (the
        day's plan, already through format_text()).

    Example context (json):
    {
        "approved": false,
        "status": "Draft: it can still be changed, imported again or deleted.",
        "hasitems": true,
        "blocks": [{
            "name": "RA1 · Reconeix els elements",
            "days": [{
                "date": "2026-09-14",
                "title": "Presentació",
                "hours": "2",
                "content": "<ul><li>Normes de l'aula</li></ul>"
            }]
        }]
    }
}}
<div class="local_classprogress-plan">
    <p class="{{#approved}}alert alert-success{{/approved}}{{^approved}}alert alert-info{{/approved}}" data-region="plan-status">{{status}}</p>
    {{#hasitems}}
        {{#blocks}}
            <h4 class="mt-4">{{name}}</h4>
            <table class="generaltable">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} date, local_classprogress {{/str}}</th>
                        <th scope="col">{{#str}} daytitle, local_classprogress {{/str}}</th>
                        <th scope="col">{{#str}} hours, local_classprogress {{/str}}</th>
                        <th scope="col">{{#str}} plannedcontent, local_classprogress {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#days}}
                        <tr>
                            <td class="text-nowrap">{{date}}</td>
                            <td>{{title}}</td>
                            <td>{{hours}}</td>
                            <td>{{{content}}}</td>
                        </tr>
                    {{/days}}
                </tbody>
            </table>
        {{/blocks}}
    {{/hasitems}}
    {{^hasitems}}
        <p>{{#str}} noitems, local_classprogress {{/str}}</p>
    {{/hasitems}}
</div>
