{{!
    @template local_classprogress/calendar_view

    The calendar of a plan: number of sessions and hours, sessions per month, sessions lost to each holiday of the
    school year, and the list of sessions.

    Context variables required for this template:
    * message - Why there is no calendar (missing, invalid, reversed or out-of-range dates); when set, nothing else is
      shown.
    * summary - Number of sessions and hours, as a sentence.
    * months - Each month from the first to the last class day: month, sessions.
    * hasholidays, holidays - Holidays of the school year: dates, label (as typed, escaped here), lost (sessions it
      removed).
    * hassessions, sessions - Every session: date, weekday, hours.

    Example context (json):
    {
        "message": null,
        "summary": "60 sessions, 120 hours of class",
        "months": [{"month": "September 2026", "sessions": 5}, {"month": "October 2026", "sessions": 8}],
        "hasholidays": true,
        "holidays": [{"dates": "2026-12-22 to 2027-01-07", "label": "Vacances de Nadal", "lost": 4}],
        "hassessions": true,
        "sessions": [{"date": "2026-09-14", "weekday": "Monday", "hours": "2"}]
    }
}}
<div class="local_classprogress-calendar">
    {{#message}}
        <div class="alert alert-info">{{message}}</div>
    {{/message}}
    {{^message}}
        <p class="lead" data-region="calendar-summary">{{summary}}</p>
        <div class="row">
            <div class="col-md-5">
                <table class="generaltable">
                    <caption>{{#str}} sessionspermonth, local_classprogress {{/str}}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} month, local_classprogress {{/str}}</th>
                            <th scope="col">{{#str}} sessions, local_classprogress {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#months}}
                            <tr><td>{{month}}</td><td>{{sessions}}</td></tr>
                        {{/months}}
                    </tbody>
                </table>
            </div>
            <div class="col-md-7">
                <table class="generaltable">
                    <caption>{{#str}} sessionslost, local_classprogress {{/str}}</caption>
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} holiday, local_classprogress {{/str}}</th>
                            <th scope="col">{{#str}} dates, local_classprogress {{/str}}</th>
                            <th scope="col">{{#str}} sessionslostcolumn, local_classprogress {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#holidays}}
                            <tr><td>{{label}}</td><td>{{dates}}</td><td>{{lost}}</td></tr>
                        {{/holidays}}
                        {{^hasholidays}}
                            <tr><td colspan="3">{{#str}} noholidays, local_classprogress {{/str}}</td></tr>
                        {{/hasholidays}}
                    </tbody>
                </table>
            </div>
        </div>
        {{#hassessions}}
            <details>
                <summary>{{#str}} allsessions, local_classprogress {{/str}}</summary>
                <table class="generaltable">
                    <thead>
                        <tr>
                            <th scope="col">{{#str}} date, local_classprogress {{/str}}</th>
                            <th scope="col">{{#str}} weekday, local_classprogress {{/str}}</th>
                            <th scope="col">{{#str}} hours, local_classprogress {{/str}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#sessions}}
                            <tr><td>{{date}}</td><td>{{weekday}}</td><td>{{hours}}</td></tr>
                        {{/sessions}}
                    </tbody>
                </table>
            </details>
        {{/hassessions}}
    {{/message}}
</div>
