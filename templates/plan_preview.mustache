{{!
    @template local_classprogress/plan_preview

    What a plan text gives before it is saved or approved: the module it stores, its RA or blocks with their days and
    hours, and every error and warning with its line.

    Context variables required for this template:
    * module - The module code and title the import stores, as typed (escaped here).
    * replaces - A sentence saying that the heading replaces the module typed for the plan, or empty.
    * hasblocks, blocks - The RA or blocks that have days, each with name (as typed, escaped here), days and hours.
    * days, hours - Number of days and total hours.
    * haserrors, errors - The errors, each with line and text ("Line 8: ...", escaped here).
    * haswarnings, warnings - The warnings, as the errors.

    Example context (json):
    {
        "module": "MP 0372 · Gestió de bases de dades",
        "replaces": "",
        "hasblocks": true,
        "blocks": [{"name": "RA1 · Reconeix els elements", "days": 6, "hours": "12"}],
        "days": 6,
        "hours": "12",
        "haserrors": true,
        "errors": [{"line": 8, "text": "Line 8: The day heading \"2026-02-30\" has no date that can be read."}],
        "haswarnings": true,
        "warnings": [{"line": 12, "text": "Line 12: The day 2026-10-12 is a holiday: Festa Nacional."}]
    }
}}
<div class="local_classprogress-preview">
    <dl class="row">
        <dt class="col-sm-3">{{#str}} module, local_classprogress {{/str}}</dt>
        <dd class="col-sm-9">{{module}}{{#replaces}}<br><span class="text-muted">{{replaces}}</span>{{/replaces}}</dd>
        <dt class="col-sm-3">{{#str}} days, local_classprogress {{/str}}</dt>
        <dd class="col-sm-9" data-region="preview-days">{{days}}</dd>
        <dt class="col-sm-3">{{#str}} hours, local_classprogress {{/str}}</dt>
        <dd class="col-sm-9" data-region="preview-hours">{{hours}}</dd>
    </dl>
    {{#hasblocks}}
        <table class="generaltable">
            <thead>
                <tr>
                    <th scope="col">{{#str}} block, local_classprogress {{/str}}</th>
                    <th scope="col">{{#str}} days, local_classprogress {{/str}}</th>
                    <th scope="col">{{#str}} hours, local_classprogress {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#blocks}}
                    <tr>
                        <td>{{name}}</td>
                        <td>{{days}}</td>
                        <td>{{hours}}</td>
                    </tr>
                {{/blocks}}
            </tbody>
        </table>
    {{/hasblocks}}
    {{#haserrors}}
        <div class="alert alert-danger" data-region="preview-errors">
            <p>{{#str}} previewerrors, local_classprogress {{/str}}</p>
            <ul>
                {{#errors}}
                    <li>{{text}}</li>
                {{/errors}}
            </ul>
        </div>
    {{/haserrors}}
    {{#haswarnings}}
        <div class="alert alert-warning" data-region="preview-warnings">
            <p>{{#str}} previewwarnings, local_classprogress {{/str}}</p>
            <ul>
                {{#warnings}}
                    <li>{{text}}</li>
                {{/warnings}}
            </ul>
        </div>
    {{/haswarnings}}
    {{^haserrors}}
        {{^haswarnings}}
            <p class="alert alert-success" data-region="preview-clean">{{#str}} previewclean, local_classprogress {{/str}}</p>
        {{/haswarnings}}
    {{/haserrors}}
</div>
