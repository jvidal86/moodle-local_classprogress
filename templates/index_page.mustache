{{!
    @template local_classprogress/index_page

    The landing page: the teacher's school years, and every plan activity the teacher can open, across courses.

    Context variables required for this template:
    * addyearurl - URL of the page that creates a school year.
    * hasyears - Whether the teacher has any school year.
    * years - School years, each with:
      * name - Name as typed (escaped here).
      * dates, counts - First and last day; number of holidays and evaluation periods.
      * editurl, deleteurl - URLs to edit or delete it.
    * hasactivities - Whether the teacher can open any plan activity.
    * activities - Plan activities, each with name and course (already through format_string()), status, pending
      (number of pending sessions; empty for a draft) and url.

    Example context (json):
    {
        "addyearurl": "https://example.com/local/classprogress/schoolyear.php",
        "hasyears": true,
        "years": [{
            "name": "Curs 2026-2027",
            "dates": "2026-09-14 to 2027-06-21",
            "counts": "Holidays: 16. Evaluation periods: 3.",
            "editurl": "https://example.com/local/classprogress/schoolyear.php?id=1",
            "deleteurl": "https://example.com/local/classprogress/schoolyear.php?id=1&action=delete"
        }],
        "hasactivities": true,
        "activities": [{
            "name": "MP 0372 Bases de dades",
            "course": "DAW 1",
            "status": "Approved",
            "pending": "2",
            "url": "https://example.com/mod/classprogress/view.php?id=7"
        }]
    }
}}
<div class="local_classprogress-index">
    <p>
        <a class="btn btn-primary" href="{{addyearurl}}">{{#str}} addschoolyear, local_classprogress {{/str}}</a>
    </p>
    {{^hasyears}}
        <p>{{#str}} noschoolyears, local_classprogress {{/str}}</p>
    {{/hasyears}}
    {{#years}}
        <section class="mt-4">
            <h3>{{name}}</h3>
            <p class="text-muted">{{dates}} · {{counts}}</p>
            <p>
                <a class="btn btn-link" href="{{editurl}}">{{#str}} editschoolyear, local_classprogress {{/str}}</a>
                <a class="btn btn-link" href="{{deleteurl}}">{{#str}} deleteschoolyear, local_classprogress {{/str}}</a>
            </p>
        </section>
    {{/years}}
    <section class="mt-4" data-region="plan-activities">
        <h3>{{#str}} planactivities, local_classprogress {{/str}}</h3>
        {{#hasactivities}}
            <table class="generaltable">
                <thead>
                    <tr>
                        <th scope="col">{{#str}} planactivity, local_classprogress {{/str}}</th>
                        <th scope="col">{{#str}} course {{/str}}</th>
                        <th scope="col">{{#str}} status, local_classprogress {{/str}}</th>
                        <th scope="col">{{#str}} pendingsessions, local_classprogress {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#activities}}
                        <tr>
                            <td><a href="{{url}}">{{{name}}}</a></td>
                            <td>{{{course}}}</td>
                            <td>{{status}}</td>
                            <td>{{pending}}</td>
                        </tr>
                    {{/activities}}
                </tbody>
            </table>
        {{/hasactivities}}
        {{^hasactivities}}
            <p>{{#str}} noplanactivities, local_classprogress {{/str}}</p>
        {{/hasactivities}}
    </section>
</div>
